#!/usr/bin/env bash
# CLI for the Wacom Support plugin daemon.
#   wacom-ctl status [--json] | start | stop | restart | probe | test N | logs | config
set -u

PLUGIN_ID="io.github.godisopensource.omarchy-wacom-support"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON="$SCRIPT_DIR/wacom-daemon.py"
STATUS="$SCRIPT_DIR/wacom-status"

# Private per-user runtime dir. Never falls back to /tmp directly: a
# world-writable predictable PID path would allow symlink/pre-create
# games. XDG_RUNTIME_DIR (/run/user/$UID, 0700) is preferred.
resolve_runtime_dir() {
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "${XDG_RUNTIME_DIR:-}" ]]; then
    printf '%s' "$XDG_RUNTIME_DIR"
    return
  fi
  local uid_dir="/run/user/$(id -u 2>/dev/null || echo 0)"
  if [[ -d "$uid_dir" ]]; then
    printf '%s' "$uid_dir"
    return
  fi
  local fallback="${HOME:-/tmp}/.local/run"
  mkdir -p "$fallback" 2>/dev/null || true
  chmod 700 "$fallback" 2>/dev/null || true
  printf '%s' "$fallback"
}
RUNTIME_DIR="$(resolve_runtime_dir)"
PID_FILE="$RUNTIME_DIR/omarchy-wacom-support.pid"
# Pre-hardening location (XDG_RUNTIME_DIR:-/tmp). Cleaned opportunistically
# on start/stop so upgrades don't leave a stale file behind.
LEGACY_PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-wacom-support.pid"

die() { echo "wacom-ctl: $*" >&2; exit 1; }

# True only when $1 is a LIVE instance of our daemon, not merely a live
# PID. Closes the PID-reuse window: a recycled PID owned by us would pass
# `kill -0` but fails the cmdline check and is treated as stale.
is_our_daemon() {
  local pid="${1:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$pid" -gt 1 ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [[ -r "/proc/$pid/cmdline" ]]; then
    if { tr '\0' ' ' < "/proc/$pid/cmdline"; } 2>/dev/null | grep -q "wacom-daemon"; then
      return 0
    fi
    return 1
  fi
  if command -v ps >/dev/null 2>&1; then
    ps -p "$pid" -o args= 2>/dev/null | grep -q "wacom-daemon" || return 1
    return 0
  fi
  return 1
}

read_pidfile() {
  local raw=""
  raw="$(cat "$PID_FILE" 2>/dev/null || echo "")"
  raw="${raw//[[:space:]]/}"
  printf '%s' "$raw"
}

# Remove the pidfile only if it still holds $1. Prevents deleting a fresh
# daemon's file in a stop/start race.
safe_remove_pidfile() {
  local expected="${1:-}"
  [[ -n "$expected" ]] || return 0
  local current=""
  current="$(read_pidfile)"
  if [[ "$current" == "$expected" ]]; then
    rm -f "$PID_FILE"
  fi
  if [[ "$LEGACY_PID_FILE" != "$PID_FILE" ]]; then
    rm -f "$LEGACY_PID_FILE" 2>/dev/null || true
  fi
}

clean_stale_pidfile() {
  if [[ -f "$PID_FILE" ]]; then
    local raw=""
    raw="$(read_pidfile)"
    if [[ -z "$raw" ]]; then
      rm -f "$PID_FILE"
      return 0
    fi
    if ! is_our_daemon "$raw"; then
      safe_remove_pidfile "$raw"
    fi
  fi
}

daemon_pid() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(read_pidfile)"
    if [[ -n "$pid" ]] && is_our_daemon "$pid"; then
      printf '%s' "$pid"
      return 0
    fi
  fi
  return 1
}

cmd_status() {
  if [[ "${1:-}" == "--json" ]]; then
    exec "$STATUS" --json
  fi
  local info name node present daemon pid
  info="$("$STATUS" --json)"
  echo "$info" | python3 -c "
import json,sys
d = json.load(sys.stdin)
print('tablet : ' + (d.get('name') or '(none)') + (' ' + d['node'] if d.get('node') else ''))
print('present: ' + str(d.get('present')))
print('daemon : ' + ('running (pid %s)' % d.get('pid') if d.get('daemon') else 'stopped'))
"
  echo "--- mapping ---"
  python3 "$DAEMON" --check-config
}

cmd_start() {
  if daemon_pid >/dev/null; then
    echo "daemon already running (pid $(daemon_pid))"
    return 0
  fi
  clean_stale_pidfile
  if daemon_pid >/dev/null; then
    echo "daemon already running (pid $(daemon_pid))"
    return 0
  fi
  [[ -x "$DAEMON" ]] || chmod +x "$DAEMON" 2>/dev/null || true
  # setsid + nohup so it survives the launching shell/widget process.
  setsid nohup python3 "$DAEMON" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
  for _ in $(seq 1 20); do
    sleep 0.15
    if daemon_pid >/dev/null; then
      echo "daemon started (pid $(daemon_pid))"
      return 0
    fi
  done
  die "daemon did not start; see ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wacom-support/daemon.log"
}

cmd_stop() {
  local pid raw stopped_msg="daemon stopped"
  if ! pid="$(daemon_pid)"; then
    raw="$(read_pidfile)"
    if [[ -n "$raw" ]] && is_our_daemon "$raw"; then
      # Raced with a fresh start between the checks: stop it below.
      pid="$raw"
    else
      if [[ -n "$raw" ]]; then
        safe_remove_pidfile "$raw"
        stopped_msg="daemon not running (stale pid file cleaned)"
      else
        rm -f "$PID_FILE" 2>/dev/null || true
        stopped_msg="daemon not running"
      fi
      pid=""
    fi
  fi
  if [[ -n "$pid" ]]; then
    # Re-verify identity immediately before signalling: the PID may have
    # been recycled since daemon_pid() ran.
    if ! is_our_daemon "$pid"; then
      safe_remove_pidfile "$pid"
      stopped_msg="daemon not running (stale pid file cleaned)"
      pid=""
    else
      kill -TERM "$pid" 2>/dev/null || true
      for _ in $(seq 1 20); do
        is_our_daemon "$pid" || break
        sleep 0.15
      done
      if is_our_daemon "$pid"; then
        echo "daemon did not stop (pid $pid still running)" >&2
        return 1
      fi
      safe_remove_pidfile "$pid"
    fi
  fi
  local swept=0
  swept="$(sweep_stragglers)"
  if [[ "$swept" -gt 0 ]]; then
    echo "$stopped_msg ($swept duplicate daemon(s) cleaned)"
  else
    echo "$stopped_msg"
  fi
}

# Count live processes running this exact daemon script, excluding ourselves.
# One-shot probes (`wacom-daemon.py --probe/--check-config/...`) share the
# script path but carry flags; only the bare long-lived daemon counts.
count_daemon_procs() {
  [[ -d /proc ]] || { printf '0'; return 0; }
  local n=0 proc pid cmd
  for proc in /proc/[0-9]*/cmdline; do
    pid="${proc#/proc/}"
    pid="${pid%/cmdline}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ "$pid" == "$$" ]] && continue
    cmd="$({ tr '\0' ' ' < "$proc"; } 2>/dev/null || echo "")"
    [[ -n "$cmd" ]] || continue
    case "$cmd" in
      *"$DAEMON --"*) continue ;;
      *"$DAEMON"*) n=$((n + 1)) ;;
    esac
  done
  printf '%s' "$n"
}

# SIGTERM any live instance of this exact daemon script beyond the pidfile
# one (e.g. duplicates from a concurrent-start race under an older version,
# or a lost pidfile). Matching is by full script path in /proc cmdline —
# never by bare PID — so recycled PIDs and unrelated processes are safe.
# Prints the number of duplicate processes signalled.
sweep_stragglers() {
  [[ -d /proc ]] || { printf '0'; return 0; }
  local proc pid cmd signalled=0
  for proc in /proc/[0-9]*/cmdline; do
    pid="${proc#/proc/}"
    pid="${pid%/cmdline}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ "$pid" == "$$" ]] && continue
    cmd="$({ tr '\0' ' ' < "$proc"; } 2>/dev/null || echo "")"
    [[ -n "$cmd" ]] || continue
    case "$cmd" in
      *"$DAEMON --"*) continue ;; # one-shot probe, not the daemon
      *"$DAEMON"*)
        # kill -0 fails for other users' processes, so only our own
        # instances are ever signalled.
        if kill -0 "$pid" 2>/dev/null; then
          kill -TERM "$pid" 2>/dev/null || true
          signalled=$((signalled + 1))
        fi
        ;;
    esac
  done
  if [[ "$signalled" -gt 0 ]]; then
    for _ in $(seq 1 20); do
      [[ "$(count_daemon_procs)" -eq 0 ]] && break
      sleep 0.15
    done
    if [[ "$(count_daemon_procs)" -gt 0 ]]; then
      echo "warning: $signalled duplicate daemon(s) signalled but still running" >&2
      printf '0'
      return 0
    fi
  fi
  printf '%s' "$signalled"
}

cmd_probe() {
  exec python3 "$DAEMON" --probe
}

cmd_test() {
  local n="${1:-}"
  [[ "$n" =~ ^[1-4]$ ]] || die "usage: wacom-ctl test N   (N = 1..4)"
  local cmd
  cmd="$(python3 "$DAEMON" --check-config | sed -n "s/^button $n \[.*\]: //p" | sed 's/  \[translated from legacy syntax\]$//')"
  if [[ -z "$cmd" || "$cmd" == "(unmapped)" ]]; then
    die "button $n is unmapped"
  fi
  echo "running button $n: $cmd"
  sh -c "$cmd" &
  disown 2>/dev/null || true
}

cmd_logs() {
  local log="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wacom-support/daemon.log"
  if [[ -f "$log" ]]; then
    tail -n "${1:-50}" "$log"
  else
    echo "no log yet ($log)"
  fi
}

cmd_config() {
  python3 "$DAEMON" --check-config
}

cmd_save_override() {
  local json="${1:-}"
  [[ -n "$json" ]] || die "usage: wacom-ctl save-override '<json>'"
  local dir="$HOME/.config/omarchy-wacom-support"
  mkdir -p "$dir"
  python3 - "$dir/buttons.json" "$json" <<'EOF'
import json, sys
path, raw = sys.argv[1], sys.argv[2]
try:
    data = json.loads(raw)
except ValueError as exc:
    print("invalid JSON: %s" % exc, file=sys.stderr)
    sys.exit(1)
if not isinstance(data, dict):
    print("JSON must be an object", file=sys.stderr)
    sys.exit(1)
kept = {k: str(v) for k, v in data.items()
        if k.startswith("label") or k.startswith("button") or k == "autoStart"}
with open(path, "w", encoding="utf-8") as fh:
    json.dump(kept, fh, indent=2, sort_keys=True)
    fh.write("\n")
print("wrote %s" % path)
EOF
}

case "${1:-status}" in
  status) shift; cmd_status "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop >/dev/null || true; cmd_start ;;
  probe) cmd_probe ;;
  test) shift; cmd_test "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  config) cmd_config ;;
  save-override) shift; cmd_save_override "$@" ;;
  *) die "usage: wacom-ctl {status|start|stop|restart|probe|test N|logs|config|save-override}" ;;
esac
